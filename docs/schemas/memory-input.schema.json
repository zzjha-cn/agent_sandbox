{
  "$id": "urn:sbx:schema:memory-input:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content": {
      "minLength": 1,
      "type": "string"
    },
    "experience": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "type": "string"
        },
        "conditions": {
          "type": "string"
        },
        "observations": {
          "type": "string"
        },
        "symptoms": {
          "type": "string"
        },
        "unknowns": {
          "type": "string"
        },
        "validation": {
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "kind": {
      "enum": [
        "testing",
        "environment",
        "constraint",
        "troubleshooting",
        "workflow"
      ],
      "type": "string"
    },
    "memory_type": {
      "enum": [
        "",
        "episodic",
        "semantic",
        "procedural"
      ],
      "type": "string"
    },
    "paths": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "requires": {
      "additionalProperties": {
        "type": "string"
      },
      "maxProperties": 32,
      "type": "object"
    },
    "source": {
      "minLength": 1,
      "type": "string"
    },
    "supersedes": {
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "kind",
    "title",
    "content",
    "source"
  ],
  "title": "sbx memory-input",
  "type": "object"
}
