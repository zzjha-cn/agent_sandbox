run
-d
--name
sbx-demo-abc123-t1
--label
sbx.role=agent
--label
sbx.task=t1
--label
sbx.ws=demo-abc123
--network
sbx-demo-abc123-t1-net
--mount
type=bind,source=/Users/me/.sbx/worktrees/demo/t1,target=/Users/me/.sbx/worktrees/demo/t1
--mount
type=volume,source=sbx-demo-abc123-t1-dep-0,target=/Users/me/.sbx/worktrees/demo/t1/node_modules
--mount
type=bind,source=/Users/me/.sbx/state/demo/t1/gen,target=/sbx/gen,readonly
-e
SBX_TASK=t1
-e
HTTPS_PROXY=http://u:p@proxy:3128
-u
1000:1000
-w
/Users/me/.sbx/worktrees/demo/t1
--cpus
2
--memory
3g
--pids-limit
1024
sbx/web-go:0123456789ab
