# sbx shared proxy 主配置（由 sbx 渲染，勿手改）
# 整个 ~/.sbx/proxy 目录挂载到 /etc/sbx，不单文件挂载（M0-3）
http_port 3128
auth_param basic program /usr/lib/squid/basic_ncsa_auth /etc/sbx/passwd
auth_param basic realm sbx
auth_param basic credentialsttl 1 hour
acl SSL_ports port 443
acl CONNECT method CONNECT
http_access deny CONNECT !SSL_ports
include /etc/sbx/tasks/*.conf
http_access deny all
{{- if .UpstreamHost}}

cache_peer {{.UpstreamHost}} parent {{.UpstreamPort}} 0 no-query no-digest default
never_direct allow all
{{- end}}

logformat sbx %ts.%03tu %un %>a %Ss/%>Hs %rm %ru %Sh/%<a
access_log stdio:/var/log/squid/access.log sbx
cache deny all
shutdown_lifetime 1 seconds
